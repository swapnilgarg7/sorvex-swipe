# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in both values, then restart `npm run dev`.
#
# Where to get them:
#   1. Open your project at https://supabase.com/dashboard
#   2. Project Settings → API Keys  (older dashboards: Settings → API)
#   3. URL              → "Project URL"          e.g. https://abcdefgh.supabase.co
#      Publishable key  → "Publishable key" (starts `sb_publishable_...`)
#                         or, on older projects, the "anon / public" key (a JWT
#                         starting `eyJ...`). Either works — see note below.
#
# Both of these are safe to expose in the browser: they are public keys and every
# table is protected by Row Level Security (see supabase/schema.sql).
#
# Do NOT put the service_role / secret key in this app. It bypasses RLS and is
# not needed — privileged work happens inside the submit_judgment SQL function.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# If your project only offers the older key name, use this line instead of the
# one above — the app accepts either and prefers PUBLISHABLE_KEY when both are set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ─── After filling these in ──────────────────────────────────────────────────
# 1. Supabase dashboard → SQL Editor → run `supabase/schema.sql`
# 2. Same editor → run `supabase/seed.sql`
# 3. Authentication → URL Configuration → add these Redirect URLs:
#      http://localhost:3000/auth/callback
#      https://<your-production-domain>/auth/callback
# 4. npm run dev
